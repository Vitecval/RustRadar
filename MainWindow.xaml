<Window x:Class="RustRadar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RustRadar.Controls"
        Title="Rust Network Research"
        Width="1550"
        Height="900"
        MinWidth="1150"
        MinHeight="700"
        Background="#161616"
        Foreground="White">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             PASSIVE CAPTURE TOOLBAR
             ========================================================= -->

        <Border Grid.Row="0"
                Background="#222222"
                CornerRadius="6"
                Padding="10">

            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text="Passive Capture"
                           FontWeight="Bold"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Button x:Name="LaunchRustButton"
                        Content="Launch Rust"
                        Width="100"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="LaunchRustButton_Click"/>

                <Button x:Name="RefreshDevicesButton"
                        Content="Refresh Adapters"
                        Width="120"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="RefreshDevicesButton_Click"/>

                <ComboBox x:Name="DeviceComboBox"
                          Width="280"
                          Height="30"
                          Margin="0,0,12,0"/>

                <TextBlock Text="Server:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <TextBox x:Name="ServerIpTextBox"
                         Text="62.233.59.69"
                         Width="120"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <TextBlock Text="Port:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <TextBox x:Name="ServerPortTextBox"
                         Text="28015"
                         Width="65"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"/>

                <Button x:Name="StartCaptureButton"
                        Content="Start Capture"
                        Width="105"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="StartCaptureButton_Click"/>

                <Button x:Name="StopCaptureButton"
                        Content="Stop"
                        Width="65"
                        Height="30"
                        IsEnabled="False"
                        Margin="0,0,12,0"
                        Click="StopCaptureButton_Click"/>

                <Button Content="MARK STILL"
                        Width="90"
                        Height="30"
                        Margin="3,0"
                        Background="#404040"
                        Foreground="White"
                        Click="MarkStill_Click"/>

                <Button Content="MARK WALK"
                        Width="90"
                        Height="30"
                        Margin="3,0"
                        Background="#404040"
                        Foreground="White"
                        Click="MarkWalk_Click"/>

                <Button Content="MARK STOP"
                        Width="90"
                        Height="30"
                        Margin="3,0"
                        Background="#404040"
                        Foreground="White"
                        Click="MarkStop_Click"/>

            </WrapPanel>

        </Border>


        <!-- =========================================================
             RUST RELAY TOOLBAR
             ========================================================= -->

        <Border Grid.Row="1"
                Background="#202020"
                CornerRadius="6"
                Padding="10"
                Margin="0,8,0,0">

            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text="RustRelay"
                           FontWeight="Bold"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Foreground="#FFB347"
                           Margin="0,0,12,0"/>

                <TextBlock Text="Listen:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <TextBox x:Name="RelayUrlTextBox"
                         Text="http://0.0.0.0:28090"
                         Width="185"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <TextBlock Text="Token:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <TextBox x:Name="RelayTokenTextBox"
                         Text="rust-radar-local-2026"
                         Width="190"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <Button x:Name="StartRelayButton"
                        Content="Start Relay"
                        Width="95"
                        Height="30"
                        Margin="0,0,6,0"
                        Click="StartRelayButton_Click"/>

                <Button x:Name="StopRelayButton"
                        Content="Stop Relay"
                        Width="95"
                        Height="30"
                        Margin="0,0,15,0"
                        IsEnabled="False"
                        Click="StopRelayButton_Click"/>

                <TextBlock Text="Status:"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>

                <TextBlock x:Name="RelayStatusText"
                           Text="STOPPED"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           Foreground="Orange"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

            </WrapPanel>

        </Border>


        <!-- =========================================================
             STATISTICS
             ========================================================= -->

        <Grid Grid.Row="2"
              Margin="0,8,0,8">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- PASSIVE STATS -->

            <UniformGrid Grid.Row="0"
                         Columns="8">

                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="UDP"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="UdpCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="RakNet"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="RakNetCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="Entities"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="EntitiesCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="Positions"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="PositionsCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="Destroy"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="DestroyCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="RPC"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="RpcCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="Protected"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="ProtectedCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>


                <Border Background="#222222"
                        Margin="2"
                        Padding="8"
                        CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="Decoded XYZ"
                                   Foreground="Gray"/>

                        <TextBlock x:Name="PlainEntityCountText"
                                   Text="0"
                                   FontSize="19"/>
                    </StackPanel>

                </Border>

            </UniformGrid>


            <!-- RELAY STATS -->

            <Border Grid.Row="1"
                    Background="#1D1D1D"
                    Margin="2,6,2,0"
                    Padding="8"
                    CornerRadius="4">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Relay packets:"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="RelayPacketCountText"
                               Text="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="6,0,25,0"/>

                    <TextBlock Text="Relay positions:"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="RelayPositionCountText"
                               Text="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="6,0,25,0"/>

                    <TextBlock Text="Active XYZ:"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="RelayEntityCountText"
                               Text="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FF6666"
                               Margin="6,0,25,0"/>

                    <TextBlock Text="Plaintext relay feeds the radar below."
                               Foreground="#777777"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =========================================================
             MAIN CONTENT
             ========================================================= -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =====================================================
                 RELAY RADAR
                 ===================================================== -->

            <Border Grid.Column="0"
                    Background="#0F0F0F"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,0,5,0"
                    Padding="5">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <DockPanel Grid.Row="0"
                               Margin="6,4,6,8">

                        <TextBlock Text="Entity Radar"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="X / Z"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>

                    </DockPanel>


                    <controls:RadarControl
                        x:Name="RelayRadarControl"
                        Grid.Row="1"/>


                    <Border Grid.Row="2"
                            Background="#171717"
                            Padding="8"
                            Margin="0,5,0,0">

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#999999">

                            <Run Text="Passive capture is preferred. "/>
                            <Run Text="Plaintext and authenticated NetProtect 01 00 EntityPosition bodies are drawn. "/>
                            <Run Text="01 01 remains opaque until its per-session key derivation is understood."/>  

                        </TextBlock>

                    </Border>

                </Grid>

            </Border>


            <!-- =====================================================
                 PACKET / EVENT LOG
                 ===================================================== -->

            <Border Grid.Column="1"
                    Background="#0F0F0F"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="5,0,0,0"
                    Padding="5">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <DockPanel Grid.Row="0"
                               Margin="5,3,5,8">

                        <TextBlock Text="Wire / Relay Events"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="Rust messages + sampled relay positions"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>

                    </DockPanel>


                    <ListBox x:Name="PacketLogListBox"
                             Grid.Row="1"
                             Background="#0F0F0F"
                             Foreground="#DADADA"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"/>

                </Grid>

            </Border>

        </Grid>


        <!-- =========================================================
             STATUS BAR
             ========================================================= -->

        <Border Grid.Row="4"
                Background="#202020"
                CornerRadius="4"
                Margin="0,8,0,0"
                Padding="8,6">

            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready."
                       Foreground="#AAAAAA"
                       FontFamily="Consolas"/>

        </Border>

    </Grid>

</Window>